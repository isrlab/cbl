{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CBL",
  "scopeName": "source.cblang",
  "fileTypes": ["cblang"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#mode-decl" },
    { "include": "#rule-keywords" },
    { "include": "#timing" },
    { "include": "#guards" },
    { "include": "#actions" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.cblang"
    },
    "sections": {
      "patterns": [
        {
          "match": "^\\s*(System)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.section.cblang" },
            "2": { "name": "entity.name.type.system.cblang" }
          }
        },
        {
          "match": "^\\s*(Initial\\s+Mode)\\s*:\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.section.cblang" },
            "2": { "name": "entity.name.tag.mode.cblang" }
          }
        },
        {
          "match": "^\\s*(Assumes|Definitions|Constants|Guarantees|Variables|Always)\\s*:",
          "captures": {
            "1": { "name": "keyword.control.section.cblang" }
          }
        }
      ]
    },
    "mode-decl": {
      "match": "^\\s*(Mode)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*:",
      "captures": {
        "1": { "name": "keyword.control.mode.cblang" },
        "2": { "name": "entity.name.tag.mode.cblang" }
      }
    },
    "rule-keywords": {
      "patterns": [
        {
          "match": "\\b(When|Otherwise|shall)\\b",
          "name": "keyword.control.rule.cblang"
        },
        {
          "match": "\\b(transition\\s+to)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.transition.cblang" },
            "2": { "name": "entity.name.tag.mode.cblang" }
          }
        },
        {
          "match": "\\b(remain\\s+in\\s+current)\\b",
          "name": "keyword.control.transition.cblang"
        }
      ]
    },
    "timing": {
      "match": "\\b(for(?:\\s+fewer\\s+than)?)\\s+(\\d+|[A-Za-z_][A-Za-z0-9_]*)\\s+(consecutive\\s+cycles)\\b",
      "captures": {
        "1": { "name": "keyword.other.timing.cblang" },
        "2": { "name": "constant.numeric.cblang" },
        "3": { "name": "keyword.other.timing.cblang" }
      }
    },
    "guards": {
      "patterns": [
        {
          "match": "\\b(is\\s+true|is\\s+false|is\\s+below|is\\s+one\\s+of|equals|exceeds)\\b",
          "name": "keyword.operator.guard.cblang"
        },
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.logical.cblang"
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "match": "\\b(set)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(to)\\b",
          "captures": {
            "1": { "name": "keyword.control.action.cblang" },
            "2": { "name": "variable.other.cblang" },
            "3": { "name": "keyword.control.action.cblang" }
          }
        },
        {
          "match": "\\b(hold|increment|reset)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.action.cblang" },
            "2": { "name": "variable.other.cblang" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(boolean|integer|real)\\b",
          "name": "support.type.primitive.cblang"
        },
        {
          "match": "\\[\\s*(default|lo|hi)\\s*:",
          "captures": {
            "1": { "name": "support.type.attribute.cblang" }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.cblang"
        },
        {
          "match": "\\b-?\\d+(\\.\\d+)?\\b",
          "name": "constant.numeric.cblang"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.enum.cblang",
          "beginCaptures": { "0": { "name": "punctuation.definition.enum.begin.cblang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.enum.end.cblang" } },
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "constant.other.enum.cblang"
            },
            {
              "match": ",",
              "name": "punctuation.separator.enum.cblang"
            }
          ]
        }
      ]
    },
    "operators": {
      "match": "[:,.]",
      "name": "punctuation.separator.cblang"
    }
  }
}
