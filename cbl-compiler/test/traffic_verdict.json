{
  "schema_version": "0.1",
  "committed_facts": {
    "schema_version": "0.1",
    "system_name": "TrafficLight",
    "assumes": [
      {"name": "pedestrian_request", "atype": "boolean", "provenance": "user_stated"},
      {"name": "timer_expired", "atype": "boolean", "provenance": "user_stated"}
