{
  "schema_version": "0.1",
  "committed_facts": {
    "schema_version": "0.1",
    "system_name": "PredicateRoundtrip",
    "assumes": [
      {"name": "sensor_a", "atype": "real[0.0..100.0]", "provenance": "user_stated"},
