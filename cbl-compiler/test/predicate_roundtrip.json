            "actions": [{"kind": "set", "name": "status", "value": "ok"}],
            "target": {"transition_to": "Normal"}
          },
          {
            "guard": {"when": {"kind": "is_below", "lhs": {"kind": "binop", "op": "-", "lhs": "sensor_a", "rhs": "sensor_b"}, "rhs": "THRESHOLD"}},
            "actions": [{"kind": "set", "name": "status", "value": "ok"}],
            "target": {"transition_to": "Normal"}
          },
          {
            "guard": {"when": {"kind": "for_n_cycles", "n": 5, "base": {"kind": "exceeds", "lhs": "sensor_a", "rhs": "THRESHOLD"}}},
