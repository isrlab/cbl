        "transitions": [
          {
            "guard": {"when": {"kind": "and", "left": {"kind": "exceeds", "lhs": "sensor_a", "rhs": "THRESHOLD"}, "right": {"kind": "is_true", "expr": "flag"}}},
            "actions": [{"kind": "set", "name": "status", "value": "warn"}],
            "target": {"transition_to": "Warning"}
          },
          {
            "guard": {"when": {"kind": "not", "operand": {"kind": "is_true", "expr": "flag"}}},
